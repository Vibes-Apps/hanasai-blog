{
  "name": "hanasai-blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "build:drafts": "tsx src/build.ts --drafts",
    "dev": "npm run build && wrangler dev --port 8790",
    "cms:build": "tsx cms/build.ts",
    "cms:dev": "npm run cms:build -- --local && wrangler dev -c cms/wrangler.jsonc --port 8791",
    "sync-site": "tsx scripts/sync-site.mts",
    "check": "tsx scripts/blog-check.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltia/cms": "0.266.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "markdown-it": "^15.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
